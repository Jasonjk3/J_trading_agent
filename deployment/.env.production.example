# =============================================================================
# 生产环境配置模板（docker-compose 后端容器专用）
#
# 使用方式：
#   cp deployment/.env.production.example deployment/.env.production
#   然后逐项替换下面的占位值，再执行
#   docker compose --env-file deployment/.env.production up -d --build
#
# 注意：
# 1. 该文件既作为 compose 的变量源（--env-file），又被挂载为容器内 /app/.env。
# 2. 应用使用 python-dotenv 的 override=True 加载，本文件中的值会覆盖
#    docker compose 里 environment 写死的同名变量 —— 数据库地址请在这里改。
# 3. 文件里包含真实密钥，已被 .gitignore 忽略，切勿提交到仓库。
# =============================================================================

# ------------------------------- 基础配置 -----------------------------------
ENVIRONMENT=pro
SERVER_HOST=0.0.0.0
SERVER_PORT=5005
VERSION=1.1.0

# JWT 签名 + 交易所密钥加密都用它：一旦上线不要再改，否则历史密文和 Token 全部失效
SECRET_KEY=请替换为至少32位的随机字符串
ACCESS_TOKEN_EXPIRE_DAY=7

# ------------------------------- 数据库 -------------------------------------
# MYSQL_HOST 必须是 compose 中的服务名 mysql（容器之间通过服务名互通）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USERNAME=quant_app
# 密码会直接拼进数据库连接串，请避开 @ : / ? # % 等字符，否则需要 URL 编码
MYSQL_PASSWORD=请替换为强密码
MYSQL_DB=quantitative

# 仅 mysql 容器初始化使用（root 密码，与应用账号无关）
MYSQL_ROOT_PASSWORD=请替换为root强密码

# ------------------------- compose 编排相关变量 -----------------------------
# 前端对外端口（80 需要 root 权限；若 80 已被占用可改成 8080）
WEB_PORT=80
# 后端在宿主机上的调试端口，仅绑定 127.0.0.1
BACKEND_PORT=5005
# 首次启动是否自动建表（幂等，可保持 true）
INIT_DB=true
# pip / npm 镜像源，国内服务器可换成：
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
#   NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
# 前后端同源部署时留空（由 nginx 反代 /v1）；分离部署时填后端完整地址
VITE_API_BASE_URL=

# ------------------------------- 大模型 -------------------------------------
# 启动时会实例化智能助手 / 飞书助手 Agent，缺少可用 key 会导致启动失败
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# 需要走本地代理时填写通用 LLM 代理地址
# LLM_PROXY=http://127.0.0.1:7890

# ------------------------------- 飞书 ---------------------------------------
# 未配置时飞书助手 Agent 可能注册失败并阻止应用启动，请按实际应用填写
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选：业务库（text2sql 等工具使用）
# DB_URL_XITING_USER_DATA=

# ------------------------------- OKX 行情/交易 ------------------------------
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_IS_SANDBOX=false
# OKX_PROXY=http://127.0.0.1:7890

# ------------------------------- 后台任务开关 -------------------------------
# 首次部署建议：只开数据类任务，交易相关全部关闭，验证通过后再逐个打开
ENABLE_PIPELINE=false
ENABLE_NEWS_INTELLIGENCE_WORKER=true
NEWS_INTELLIGENCE_WORKER_INTERVAL=60
ENABLE_DATA_MONITOR_WORKER=true
DATA_MONITOR_POLL_SECONDS=5
# 实盘调度：开启后会对运行中的交易 Agent 真实决策下单，务必先确认沙盒验证
ENABLE_LIVE_TRADING_SCHEDULER=false
# 实盘/模拟的全局沙盒开关（true 表示不真实下单）
TRADING_SANDBOX_MODE=true
# 模拟盘 Agent 调度
ENABLE_PAPER_TRADING_SCHEDULER=false
PAPER_TRADING_POLL_SECONDS=60
# 回测任务回收间隔（秒）
BACKTEST_WATCHDOG_INTERVAL=60

# ------------------------------- Redis --------------------------------------
# 仅 ENABLE_PIPELINE=true（消息管道）时需要，compose 已内置 redis 服务
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ------------------------------- 日志 ---------------------------------------
# pro 环境默认输出 JSON 到 stderr，由 docker 收集
# LOG_FORMAT=json
# SQL_DEBUG=false
